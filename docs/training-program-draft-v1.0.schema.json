{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.example.com/schemas/training-program-draft-v1.0.schema.json",
  "title": "training-program-draft v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "source", "program", "templates", "schedule_slots"],
  "properties": {
    "schema": {"const": "training-program-draft"},
    "schema_version": {"const": "1.0"},
    "source": {"enum": ["manual", "webmcp"]},
    "program": {"$ref": "#/$defs/program"},
    "templates": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/template"}
    },
    "schedule_slots": {
      "type": "array",
      "maxItems": 7,
      "items": {"$ref": "#/$defs/schedule_slot"}
    }
  },
  "$defs": {
    "identifier80": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "name", "description", "version", "change_reason", "parent_version", "parent_aggregate_hash"],
      "properties": {
        "program_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 190,
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 190},
        "description": {"type": ["string", "null"], "maxLength": 10000},
        "version": {"type": "integer", "minimum": 1, "maximum": 100000},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "parent_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 99999},
        "parent_aggregate_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "name", "type", "exercises"],
      "properties": {
        "template_id": {"$ref": "#/$defs/identifier80"},
        "name": {"type": "string", "minLength": 1, "maxLength": 190},
        "type": {"enum": ["strength", "swimming", "cardio", "mobility", "other"]},
        "goal": {"type": ["string", "null"], "maxLength": 5000},
        "estimated_duration_min": {"type": "integer", "minimum": 1, "maximum": 1440},
        "trainer_notes": {"type": ["string", "null"], "maxLength": 10000},
        "pre_workout": {"$ref": "#/$defs/pre_workout"},
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/exercise"}
        }
      }
    },
    "pre_workout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructions": {"type": ["string", "null"], "maxLength": 2000},
        "nutrition": {"type": ["string", "null"], "maxLength": 2000},
        "equipment": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "schedule_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "template_id"],
      "properties": {
        "weekday": {"type": "integer", "minimum": 1, "maximum": 7},
        "template_id": {"$ref": "#/$defs/identifier80"}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise_id", "name", "order", "sets", "rep_range", "target_rir", "rest_seconds"],
      "properties": {
        "exercise_id": {"$ref": "#/$defs/identifier80"},
        "name": {"type": "string", "minLength": 1, "maxLength": 190},
        "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "sets": {"type": "integer", "minimum": 1, "maximum": 20},
        "rep_range": {"$ref": "#/$defs/rep_range"},
        "target_rir": {"$ref": "#/$defs/rir_range"},
        "rest_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "category": {"type": ["string", "null"], "maxLength": 80},
        "muscles": {
          "type": "array",
          "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "exercise_type": {"type": ["string", "null"], "maxLength": 40},
        "equipment": {"type": ["string", "null"], "maxLength": 120},
        "progression_increment": {"type": "number", "minimum": 0.01, "maximum": 1000},
        "progression_mode": {"enum": ["absolute", "percent"]},
        "weight": {"type": ["number", "null"], "minimum": 0, "maximum": 2000},
        "warmup_sets": {"type": "boolean"},
        "set_type": {"enum": ["normal", "superset", "dropset", "rest_pause", "cluster", "amrap"]},
        "group_id": {"type": ["string", "null"], "maxLength": 64},
        "instructions": {"type": ["string", "null"], "maxLength": 5000}
      }
    },
    "rep_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "rir_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number", "minimum": 0, "maximum": 10},
        "max": {"type": "number", "minimum": 0, "maximum": 10}
      }
    }
  }
}
